# =============================================================================
# Backend (Elixir/Phoenix)
# =============================================================================

# The directory Mix will write compiled artifacts to.
/backend/_build/

# If you run "mix test --cover", coverage assets end up here.
/backend/cover/

# The directory Mix downloads your dependencies sources to.
/backend/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/backend/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/backend/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/backend/tmp/

# Ignore package tarball (built via "mix hex.build").
template_app-*.tar

# Ignore assets that are produced by build tools.
/backend/priv/static/assets/

# Ignore digested assets cache.
/backend/priv/static/cache_manifest.json

# Elixir LS
/backend/.elixir_ls/

# =============================================================================
# Frontend (SvelteKit)
# =============================================================================

# Dependencies
/frontend/node_modules/

# Build output
/frontend/build/
/frontend/.svelte-kit/

# Generated API files (ash_typescript output)
/frontend/src/lib/generated/

# npm debug
npm-debug.log

# =============================================================================
# Environment & Secrets
# =============================================================================

# Env Vars (never commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Claude Code machine-local settings
.claude/settings.local.json

# =============================================================================
# IDE & Editor
# =============================================================================

.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS Files
# =============================================================================

.DS_Store
Thumbs.db

# =============================================================================
# Development Data
# =============================================================================

data/

# =============================================================================
# AI/Agentic Tools
# =============================================================================

.aider*
# Note: .claude/ and CLAUDE.md are tracked for team knowledge sharing

# Claude Code cache (never commit)
.claude/cache/
.claude/history/

# =============================================================================
# Git Hooks
# =============================================================================

# Lefthook local configuration (optional override)
lefthook-local.yml

# =============================================================================
# AI workflow scratch (planning artifacts — not committed)
# =============================================================================
.ai/
.goosehints

# Local mise overrides
mise.local.toml
mise.local.lock
