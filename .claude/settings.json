{
  "permissions": {
    "allowed_commands": [
      "git status",
      "git diff",
      "git add",
      "git branch",
      "git log",
      "git checkout",
      "mix format",
      "mix format --check-formatted",
      "mix test",
      "mix phx.server",
      "mix ash.codegen",
      "mix ash.setup",
      "mix ecto.migrate",
      "mix ecto.reset",
      "mix deps.get",
      "mix compile",
      "mix clean",
      "npm run format",
      "npm run lint",
      "npm run lint:fix",
      "npm run check",
      "npm run build",
      "npm run dev",
      "npm run test:unit",
      "npm run test:e2e",
      "npm install",
      "gh pr list",
      "gh pr view"
    ]
  },
  "formatting": {
    "elixir": "mix format",
    "typescript": "cd frontend && npm run lint:fix"
  },
  "codegen": {
    "ash_migrations": "mix ash.codegen"
  },
  "testing": {
    "elixir": "MIX_ENV=test mix test",
    "frontend": "cd frontend && npm run test:unit",
    "frontend_e2e": "cd frontend && npm run test:e2e"
  },
  "project": {
    "name": "TemplateApp",
    "type": "phoenix-ash-sveltekit",
    "elixir_version": "1.15+",
    "phoenix_version": "1.8",
    "ash_version": "3.x",
    "api_style": "rest-json",
    "frontend_framework": "sveltekit",
    "styling": "tailwindcss"
  }
}