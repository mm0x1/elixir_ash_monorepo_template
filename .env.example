# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development: Use individual connection parameters (docker-compose friendly)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=database_name
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_SIZE=10

# Production: Use DATABASE_URL instead (overrides individual params above)
# Required in production, optional in development
# DATABASE_URL=postgresql://user:pass@host:5432/database

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for Phoenix server
PORT=4000

# Production: External hostname for URL generation
# PHX_HOST=example.com

# Production: Enable server in releases (set to true)
# PHX_SERVER=true

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================
# IMPORTANT: Generate new secrets for production!
# Use: mix phx.gen.secret [bytes]

# Secret key base for encrypting/signing data (64+ bytes)
SECRET_KEY_BASE="changeme_run_mix_phx_gen_secret_to_generate_a_new_secret_key_base"

# JWT/Token signing secret (32+ bytes)
TOKEN_SIGNING_SECRET="changeme_run_mix_phx_gen_secret_32_to_generate_a_new_token_secret"

# Production: Force SSL/HTTPS redirects
# FORCE_SSL=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application branding (optional - has sensible defaults)
APP_NAME="Phoenix App Template"
APP_DESCRIPTION="A modern web application built with Phoenix and Ash Framework"
COMPANY_NAME="Your Company"

# Feature flags
ENABLE_REGISTRATION=true

# Optional: Support email for contact forms
# SUPPORT_EMAIL=support@example.com

# Optional: Default theme (light or dark)
# DEFAULT_THEME=light

# Optional: Username change cooldown in days (default: 30)
# USERNAME_COOLDOWN_DAYS=30

# Optional: Number of recovery codes to generate (default: 6)
# RECOVERY_CODE_COUNT=6

# =============================================================================
# LOGGING
# =============================================================================
# Log level: debug, info, warning, error (default: info)
LOG_LEVEL=debug

# =============================================================================
# PRODUCTION-ONLY OPTIONS
# =============================================================================
# DNS cluster query for distributed Elixir (advanced)
# DNS_CLUSTER_QUERY=my-app.internal

# Enable IPv6 for database connections
# ECTO_IPV6=true
