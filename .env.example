# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development only: use individual connection parameters with the local Compose
# database. Never reuse these predictable credentials for a shared or production
# database.
# These defaults work with: docker compose -f docker-compose.db.yml up -d
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=template_app_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_SIZE=10
# Compose binds PostgreSQL to loopback by default. Change this only for an
# intentional local remote-client override, never for production deployment.
DATABASE_BIND_ADDRESS=127.0.0.1

# Production: Use DATABASE_URL instead (overrides individual params above)
# Required in production, optional in development
# DATABASE_URL=postgresql://user:pass@host:5432/database

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for Phoenix server
PORT=4000

# Production: External hostname for URL generation (required)
# PHX_HOST=app.example.com

# Production: Enable server in releases (set to true)
# PHX_SERVER=true

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================
# IMPORTANT: Generate new secrets for production!
# Use: mix phx.gen.secret [bytes]

# Secret key base for encrypting/signing data (64+ bytes)
SECRET_KEY_BASE="changeme_run_mix_phx_gen_secret_to_generate_a_new_secret_key_base"

# JWT/Token signing secret for Joken access tokens (32+ bytes)
TOKEN_SIGNING_SECRET="changeme_run_mix_phx_gen_secret_32_to_generate_a_new_token_secret"

# AshAuthentication signing secret (32+ bytes) — must differ from TOKEN_SIGNING_SECRET
ASH_AUTH_SIGNING_SECRET="changeme_run_mix_phx_gen_secret_32_for_ash_auth"

# Production: require HTTPS at the reverse-proxy boundary
# FORCE_SSL=true
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS=10.0.0.10,10.0.0.11

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Feature flags
ENABLE_REGISTRATION=true

# Optional: Username change cooldown in days (default: 30)
# USERNAME_COOLDOWN_DAYS=30

# Optional: Number of recovery codes to generate (default: 6)
# RECOVERY_CODE_COUNT=6

# Optional: Recovery-code batch lifetime in seconds (60..2592000, default: 3600)
# RECOVERY_CODE_TTL_SECONDS=3600

# =============================================================================
# LOGGING
# =============================================================================
# Log level: debug, info, warning, error (default: info)
LOG_LEVEL=debug

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Optional API URL for a separately hosted frontend. Use an exact HTTPS origin.
# Leave empty in local development and in the combined Phoenix release to use
# same-origin requests or the Vite proxy.
VITE_API_URL=

# Application name shown in UI
VITE_APP_NAME="Template App"

# =============================================================================
# PRODUCTION-ONLY OPTIONS
# =============================================================================
# Frontend URL for CORS (required in production; use the same origin for the
# combined release or the exact static frontend origin when hosted separately)
# Must be one exact origin, including scheme and optional port, with no path,
# wildcard, or trailing slash. The backend sends credentialed CORS headers only
# for this origin.
# FRONTEND_URL=https://app.example.com

# DNS cluster query for distributed Elixir (advanced)
# DNS_CLUSTER_QUERY=my-app.internal

# Enable IPv6 for database connections
# ECTO_IPV6=true
